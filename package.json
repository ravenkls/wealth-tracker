{
  "name": "wealth-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @wealth/web --filter @wealth/api dev",
    "dev:setup": "node scripts/setup-env.mjs && pnpm db:up && pnpm db:init",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "pnpm --filter @wealth/api db:init",
    "db:check": "pnpm --filter @wealth/api db:check",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.24.0"
}
